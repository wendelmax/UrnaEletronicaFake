<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UrnaEletronicaFake.Web.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="UrnaEletronicaFake.Web.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Sistema de Urna Eletrônica - Web"
        Width="1400" Height="900"
        MinWidth="1200" MinHeight="800"
        Background="{StaticResource BackgroundPrimaryBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource PrimaryBrush}" 
                Padding="24"
                Effect="{StaticResource ShadowMedium}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                <!-- Logo e Título -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Border Background="{StaticResource BackgroundElevatedBrush}" 
                            CornerRadius="{StaticResource RadiusLarge}" 
                            Padding="8"
                            Width="56" Height="56">
                        <TextBlock Text="🌐" 
                                   FontSize="28" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sistema de Urna Eletrônica" 
                                   FontSize="{StaticResource FontSizeXXXL}" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextOnPrimaryBrush}"/>
                        <TextBlock Text="Versão Web - Administração" 
                                   FontSize="{StaticResource FontSizeM}" 
                                   Foreground="{StaticResource TextOnPrimaryBrush}" 
                                   Opacity="0.9"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status e Controles -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            Spacing="8"
                            VerticalAlignment="Center">
                    
                    <!-- Status do Sistema -->
                    <Border Background="{StaticResource SuccessBrush}" 
                            CornerRadius="{StaticResource RadiusLarge}" 
                            Padding="8">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Fill="{StaticResource TextOnPrimaryBrush}" 
                                     Width="8" Height="8"/>
                            <TextBlock Text="Sistema Web Online" 
                                       FontSize="{StaticResource FontSizeS}" 
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextOnPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo Principal -->
        <ScrollViewer Grid.Row="1" 
                      Padding="24" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24">
                
                <!-- Grid de Funcionalidades Web -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                    
                    <!-- Painel Administrativo -->
                    <Border Grid.Row="0" Grid.Column="0" 
                            Classes="card">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" 
                                        Background="{StaticResource PrimaryBrush}" 
                                        CornerRadius="{StaticResource RadiusLarge}" 
                                        Padding="8"
                                        Width="56" Height="56">
                                    <TextBlock Text="⚙️" 
                                               FontSize="28" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" 
                                            Margin="8,0,0,0">
                                    <TextBlock Text="Painel Administrativo" 
                                               Classes="subheading"/>
                                    <TextBlock Text="Configuração e Gestão" 
                                               Classes="caption"/>
                                </StackPanel>
                            </Grid>
                            
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Classes="status-online"/>
                                <TextBlock Text="Sempre disponível" 
                                           Classes="body"/>
                            </StackPanel>
                            
                            <TextBlock Text="Configure eleições, candidatos, cargos e gerencie todo o sistema administrativo." 
                                       Classes="body"/>
                            
                            <Button Content="Abrir Administração" 
                                    Classes="secondary large"
                                    Command="{Binding AbrirAdminCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Dashboard de Monitoramento -->
                    <Border Grid.Row="0" Grid.Column="1" 
                            Classes="card">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" 
                                        Background="{StaticResource WarningBrush}" 
                                        CornerRadius="{StaticResource RadiusLarge}" 
                                        Padding="8"
                                        Width="56" Height="56">
                                    <TextBlock Text="📊" 
                                               FontSize="28" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" 
                                            Margin="8,0,0,0">
                                    <TextBlock Text="Dashboard de Monitoramento" 
                                               Classes="subheading"/>
                                    <TextBlock Text="Acompanhamento em Tempo Real" 
                                               Classes="caption"/>
                                </StackPanel>
                            </Grid>
                            
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Classes="status-online"/>
                                <TextBlock Text="Sempre disponível" 
                                           Classes="body"/>
                            </StackPanel>
                            
                            <TextBlock Text="Monitore estatísticas, resultados parciais e status de todos os equipamentos em tempo real." 
                                       Classes="body"/>
                            
                            <Button Content="Abrir Dashboard" 
                                    Classes="secondary large"
                                    Command="{Binding AbrirDashboardCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Auditoria -->
                    <Border Grid.Row="1" Grid.Column="0" 
                            Classes="card">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" 
                                        Background="{StaticResource InfoBrush}" 
                                        CornerRadius="{StaticResource RadiusLarge}" 
                                        Padding="8"
                                        Width="56" Height="56">
                                    <TextBlock Text="🔍" 
                                               FontSize="28" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" 
                                            Margin="8,0,0,0">
                                    <TextBlock Text="Auditoria" 
                                               Classes="subheading"/>
                                    <TextBlock Text="Logs e Rastreamento" 
                                               Classes="caption"/>
                                </StackPanel>
                            </Grid>
                            
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Classes="status-online"/>
                                <TextBlock Text="Sempre disponível" 
                                           Classes="body"/>
                            </StackPanel>
                            
                            <TextBlock Text="Visualize logs de auditoria, rastreamento de atividades e relatórios de segurança." 
                                       Classes="body"/>
                            
                            <Button Content="Abrir Auditoria" 
                                    Classes="secondary large"
                                    Command="{Binding AbrirAuditoriaCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Resultados -->
                    <Border Grid.Row="1" Grid.Column="1" 
                            Classes="card">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" 
                                        Background="{StaticResource SuccessBrush}" 
                                        CornerRadius="{StaticResource RadiusLarge}" 
                                        Padding="8"
                                        Width="56" Height="56">
                                    <TextBlock Text="📈" 
                                               FontSize="28" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" 
                                            Margin="8,0,0,0">
                                    <TextBlock Text="Resultados" 
                                               Classes="subheading"/>
                                    <TextBlock Text="Relatórios e Estatísticas" 
                                               Classes="caption"/>
                                </StackPanel>
                            </Grid>
                            
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Classes="status-online"/>
                                <TextBlock Text="Sempre disponível" 
                                           Classes="body"/>
                            </StackPanel>
                            
                            <TextBlock Text="Visualize resultados das eleições, estatísticas detalhadas e relatórios de votação." 
                                       Classes="body"/>
                            
                            <Button Content="Abrir Resultados" 
                                    Classes="secondary large"
                                    Command="{Binding AbrirResultadosCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" 
                Background="{StaticResource BackgroundElevatedBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,1,0,0"
                Padding="24">
            <TextBlock Text="Sistema de Urna Eletrônica - Versão Web | Desenvolvido com Avalonia WebAssembly" 
                       Classes="caption"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
