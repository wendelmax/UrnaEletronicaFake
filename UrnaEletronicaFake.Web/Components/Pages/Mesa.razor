@page "/mesa"

<PageTitle>Mesa Receptora - Controle de Acesso</PageTitle>

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <div class="avatar avatar-lg me-3" style="background-color: var(--success-100); color: var(--success-600);">
                                👥
                            </div>
                            <div>
                                <h2 class="text-xl font-bold text-primary mb-1">Mesa Receptora</h2>
                                <p class="text-secondary mb-0">Controle de Acesso dos Eleitores</p>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="status-indicator">
                                <div class="status-dot status-dot-success"></div>
                                <span class="text-sm text-secondary">Mesa Ativa</span>
                            </div>
                            <div class="text-sm text-tertiary mt-1">
                                @DateTime.Now.ToString("HH:mm:ss dd/MM/yyyy")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Identificação do Eleitor -->
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h4 class="text-lg font-semibold mb-4">
                        <span class="me-2">🆔</span>
                        Identificação do Eleitor
                    </h4>

                    <form>
                        <div class="mb-3">
                            <label class="form-label">Número do Título de Eleitor</label>
                            <input type="text" class="form-control" placeholder="Digite o número do título" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nome do Eleitor</label>
                            <input type="text" class="form-control" placeholder="Digite o nome completo" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Data de Nascimento</label>
                            <input type="date" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nome da Mãe</label>
                            <input type="text" class="form-control" placeholder="Nome completo da mãe" />
                        </div>

                        <div class="d-grid gap-2">
                            <button class="btn btn-primary btn-lg" type="button">
                                <span class="me-2">🔍</span>
                                Verificar Eleitor
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Status da Mesa -->
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h4 class="text-lg font-semibold mb-4">
                        <span class="me-2">📊</span>
                        Status da Mesa
                    </h4>

                    <!-- Estatísticas -->
                    <div class="row mb-4">
                        <div class="col-6">
                            <div class="stat-card">
                                <div class="stat-number">127</div>
                                <div class="stat-label">Eleitores Votaram</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card">
                                <div class="stat-number">45</div>
                                <div class="stat-label">Aguardando</div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-6">
                            <div class="stat-card">
                                <div class="stat-number">172</div>
                                <div class="stat-label">Total da Seção</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card">
                                <div class="stat-number">73.8%</div>
                                <div class="stat-label">Participação</div>
                            </div>
                        </div>
                    </div>

                    <!-- Progresso -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-sm font-medium">Progresso da Votação</span>
                            <span class="text-sm text-secondary">73.8%</span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar bg-success" style="width: 73.8%"></div>
                        </div>
                    </div>

                    <!-- Controles da Mesa -->
                    <div class="d-grid gap-2">
                        <button class="btn btn-success">
                            <span class="me-2">✅</span>
                            Liberar Urna para Votação
                        </button>
                        <button class="btn btn-warning">
                            <span class="me-2">⏸️</span>
                            Pausar Votação
                        </button>
                        <button class="btn btn-danger">
                            <span class="me-2">⏹️</span>
                            Finalizar Votação
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Lista de Eleitores -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="text-lg font-semibold mb-4">
                        <span class="me-2">👥</span>
                        Eleitores da Seção
                    </h4>

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Nome</th>
                                    <th>Título</th>
                                    <th>Status</th>
                                    <th>Horário</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>João Silva Santos</td>
                                    <td>123456789012</td>
                                    <td><span class="badge badge-success">Votou</span></td>
                                    <td>14:30</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-secondary">Ver Detalhes</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Maria Oliveira Costa</td>
                                    <td>987654321098</td>
                                    <td><span class="badge badge-warning">Aguardando</span></td>
                                    <td>-</td>
                                    <td>
                                        <button class="btn btn-sm btn-primary">Liberar</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Pedro Santos Lima</td>
                                    <td>456789123456</td>
                                    <td><span class="badge badge-success">Votou</span></td>
                                    <td>14:25</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-secondary">Ver Detalhes</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .stat-card {
        text-align: center;
        padding: 1rem;
        background-color: var(--background-tertiary);
        border-radius: 8px;
        border: 1px solid var(--border-light);
    }

    .stat-number {
        font-size: 2rem;
        font-weight: bold;
        color: var(--primary-600);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.875rem;
        color: var(--text-secondary);
        margin-top: 0.5rem;
    }

    .progress {
        height: 8px;
        background-color: var(--background-tertiary);
        border-radius: 4px;
        overflow: hidden;
    }

    .progress-bar {
        height: 100%;
        background-color: var(--success-500);
        transition: width 0.3s ease;
    }

    .table th {
        background-color: var(--background-secondary);
        border-bottom: 2px solid var(--border-light);
        font-weight: 600;
        color: var(--text-primary);
    }

    .table td {
        border-bottom: 1px solid var(--border-light);
        color: var(--text-secondary);
        vertical-align: middle;
    }

    .table tbody tr:hover {
        background-color: var(--background-tertiary);
    }

    .form-control {
        border: 1px solid var(--border-medium);
        border-radius: 6px;
        padding: 0.75rem;
        font-size: 1rem;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

    .form-control:focus {
        border-color: var(--primary-500);
        box-shadow: 0 0 0 3px var(--primary-100);
        outline: none;
    }

    .form-label {
        font-weight: 500;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
    }
</style>

