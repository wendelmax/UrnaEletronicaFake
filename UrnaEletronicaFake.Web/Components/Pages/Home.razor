@page "/"

<PageTitle>Urna Eletrônica - Sistema de Votação</PageTitle>

<div class="container">
    <!-- Header Principal -->
    <div class="text-center mb-5">
        <div class="d-flex justify-content-center align-items-center mb-3">
            <div class="avatar avatar-lg me-3">
                🏛️
            </div>
            <h1 class="text-3xl font-bold text-primary mb-0">Urna Eletrônica</h1>
        </div>
        <p class="text-lg text-secondary">Sistema de votação digital moderno e seguro</p>
    </div>

    <!-- Status da Eleição -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div class="status-indicator me-3">
                        <div class="status-dot status-dot-warning"></div>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold mb-1">Status da Eleição</h3>
                        <p class="text-secondary mb-0">Aguardando início da eleição</p>
                    </div>
                </div>
                <div class="text-end">
                    <div class="badge badge-warning">Pendente</div>
                    <div class="text-sm text-tertiary mt-1">Última atualização: @DateTime.Now.ToString("HH:mm:ss dd/MM/yyyy")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Grid de Módulos -->
    <div class="grid grid-cols-2 mb-5">
        
        <!-- Urna Eletrônica -->
        <div class="card blazor-component">
            <div class="card-body">
                <div class="d-flex align-items-start mb-3">
                    <div class="avatar me-3">
                        🗳️
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h4 class="text-lg font-semibold mb-1">Urna Eletrônica</h4>
                            <div class="badge badge-primary">Votação</div>
                        </div>
                        <p class="text-sm text-secondary mb-0">Terminal de Votação</p>
                    </div>
                </div>
                
                <div class="status-indicator mb-3">
                    <div class="status-dot status-dot-offline"></div>
                    <span class="text-sm text-secondary">Aguardando início da eleição</span>
                </div>
                
                <p class="text-sm text-tertiary mb-3">
                    Este terminal permite que os eleitores realizem seus votos de forma segura e confidencial.
                </p>
                
                <NavLink href="/votacao" class="btn btn-primary w-100">
                    <span class="me-2">🚀</span>
                    Abrir Urna
                </NavLink>
            </div>
        </div>

        <!-- Mesa Receptora -->
        <div class="card blazor-component">
            <div class="card-body">
                <div class="d-flex align-items-start mb-3">
                    <div class="avatar me-3" style="background-color: var(--success-100); color: var(--success-600);">
                        👥
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h4 class="text-lg font-semibold mb-1">Mesa Receptora</h4>
                            <div class="badge badge-success">Mesa</div>
                        </div>
                        <p class="text-sm text-secondary mb-0">Controle de Acesso</p>
                    </div>
                </div>
                
                <div class="status-indicator mb-3">
                    <div class="status-dot status-dot-offline"></div>
                    <span class="text-sm text-secondary">Aguardando início da eleição</span>
                </div>
                
                <p class="text-sm text-tertiary mb-3">
                    Interface para mesários controlarem o acesso dos eleitores e liberar a urna para votação.
                </p>
                
                <NavLink href="/mesa" class="btn btn-primary w-100">
                    <span class="me-2">👨‍💼</span>
                    Abrir Mesa
                </NavLink>
            </div>
        </div>

        <!-- Dashboard de Monitoramento -->
        <div class="card blazor-component">
            <div class="card-body">
                <div class="d-flex align-items-start mb-3">
                    <div class="avatar me-3" style="background-color: var(--warning-100); color: var(--warning-600);">
                        📊
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h4 class="text-lg font-semibold mb-1">Dashboard de Monitoramento</h4>
                            <div class="badge badge-warning">Monitor</div>
                        </div>
                        <p class="text-sm text-secondary mb-0">Acompanhamento em Tempo Real</p>
                    </div>
                </div>
                
                <div class="status-indicator mb-3">
                    <div class="status-dot status-dot-success"></div>
                    <span class="text-sm text-secondary">Sempre disponível</span>
                </div>
                
                <p class="text-sm text-tertiary mb-3">
                    Monitore estatísticas, resultados parciais e status de todos os equipamentos em tempo real.
                </p>
                
                <NavLink href="/dashboard" class="btn btn-outline w-100">
                    <span class="me-2">📈</span>
                    Abrir Dashboard
                </NavLink>
            </div>
        </div>

        <!-- Painel Administrativo -->
        <div class="card blazor-component">
            <div class="card-body">
                <div class="d-flex align-items-start mb-3">
                    <div class="avatar me-3" style="background-color: var(--info-100); color: var(--info-600);">
                        ⚙️
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h4 class="text-lg font-semibold mb-1">Painel Administrativo</h4>
                            <div class="badge badge-info">Admin</div>
                        </div>
                        <p class="text-sm text-secondary mb-0">Configuração e Gestão</p>
                    </div>
                </div>
                
                <div class="status-indicator mb-3">
                    <div class="status-dot status-dot-success"></div>
                    <span class="text-sm text-secondary">Sempre disponível</span>
                </div>
                
                <p class="text-sm text-tertiary mb-3">
                    Configure eleições, candidatos, cargos e gerencie todo o sistema administrativo.
                </p>
                
                <NavLink href="/administracao" class="btn btn-outline w-100">
                    <span class="me-2">🔧</span>
                    Abrir Administração
                </NavLink>
            </div>
        </div>
    </div>

    <!-- Informações Adicionais -->
    <div class="grid grid-cols-2">
        <div class="card">
            <div class="card-body">
                <h5 class="text-lg font-semibold mb-3">
                    <span class="me-2">🔍</span>
                    Auditoria
                </h5>
                <p class="text-sm text-tertiary mb-3">
                    Acesse logs detalhados e registros de auditoria do sistema.
                </p>
                <button class="btn btn-secondary w-100">
                    <span class="me-2">📋</span>
                    Abrir Auditoria
                </button>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5 class="text-lg font-semibold mb-3">
                    <span class="me-2">📈</span>
                    Resultados
                </h5>
                <p class="text-sm text-tertiary mb-3">
                    Visualize resultados finais e estatísticas da eleição.
                </p>
                <button class="btn btn-secondary w-100">
                    <span class="me-2">📊</span>
                    Ver Resultados
                </button>
            </div>
        </div>
    </div>
</div>
