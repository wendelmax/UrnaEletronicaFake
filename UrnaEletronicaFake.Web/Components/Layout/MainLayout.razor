@inherits LayoutComponentBase

<div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <header class="bg-white shadow-sm border-b border-gray-200">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center py-3">
                <div class="d-flex align-items-center">
                    <div class="avatar me-3">
                        🏛️
                    </div>
                    <div>
                        <h1 class="text-xl font-bold text-primary mb-0">Urna Eletrônica</h1>
                        <p class="text-sm text-secondary mb-0">Sistema de Votação Digital</p>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="status-indicator">
                        <div class="status-dot status-dot-success"></div>
                        <span class="text-sm text-secondary">Sistema Online</span>
                    </div>
                    <div class="text-end">
                        <div class="text-sm font-medium text-primary">@DateTime.Now.ToString("dd/MM/yyyy")</div>
                        <div class="text-xs text-tertiary">@DateTime.Now.ToString("HH:mm:ss")</div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="py-4">
        <div class="container">
            @Body
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 mt-auto">
        <div class="container py-4">
            <div class="d-flex justify-content-between align-items-center">
                <div class="text-sm text-tertiary">
                    © @DateTime.Now.Year Urna Eletrônica - Sistema de Votação Digital
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="status-indicator">
                        <div class="status-dot status-dot-info"></div>
                        <span class="text-xs text-secondary">Versão 1.0.0</span>
                    </div>
                    <div class="status-indicator">
                        <div class="status-dot status-dot-success"></div>
                        <span class="text-xs text-secondary">Seguro</span>
                    </div>
                </div>
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro não tratado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>
