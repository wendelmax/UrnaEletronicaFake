<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UrnaEletronicaFake.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="UrnaEletronicaFake.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Sistema de Urna Eletrônica"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource BackgroundBrushDynamic}">

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrushDynamic}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource HeaderBrushDynamic}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrushDynamic}"/>
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrushDynamic}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="*">

        <!-- Main Content -->
        <!-- Área de Controle Central -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SurfaceBrushDynamic}"
                BorderBrush="{DynamicResource DividerBrushDynamic}"
                BorderThickness="1"
                CornerRadius="12"
                        Margin="20"
                Padding="30">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="30">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🎛️ Painel de Controle Central" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrushDynamic}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Gerencie todas as janelas do sistema de votação" 
                               FontSize="16"
                               Foreground="{DynamicResource TextSecondaryBrushDynamic}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>
                
                <!-- Controles de Janelas -->
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" 
                      HorizontalAlignment="Center">
                    
                    <!-- Dashboard -->
                    <Border Grid.Row="0" Grid.Column="0"
                            Background="{DynamicResource AccentBrushDynamic}"
                            CornerRadius="12"
                            Padding="20"
                            Margin="10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📊" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Dashboard" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Monitoramento" 
                                       FontSize="12" 
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,10"/>
                            <Button Content="Abrir"
                                    Command="{Binding AbrirDashboardWindowCommand}"
                                    Background="White"
                                    Foreground="{DynamicResource AccentBrushDynamic}"
                                    Padding="15,8"
                                    CornerRadius="8"
                                    BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Mesa -->
                    <Border Grid.Row="0" Grid.Column="1"
                            Background="{DynamicResource SuccessBrushDynamic}"
                            CornerRadius="12"
                            Padding="20"
                            Margin="10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🧑‍⚖️" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Mesa" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Receptora" 
                                       FontSize="12" 
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,10"/>
                            <Button Content="Abrir"
                                    Command="{Binding AbrirMesaWindowCommand}"
                                    Background="White"
                                    Foreground="{DynamicResource SuccessBrushDynamic}"
                                    Padding="15,8"
                                    CornerRadius="8"
                                    BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Urna -->
                    <Border Grid.Row="0" Grid.Column="2"
                            Background="{DynamicResource PrimaryBrushDynamic}"
                            CornerRadius="12"
                            Padding="20"
                            Margin="10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🗳️" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Urna" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Eletrônica" 
                                       FontSize="12" 
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,10"/>
                            <Button Content="Abrir"
                                    Command="{Binding AbrirVotacaoWindowCommand}"
                                    Background="White"
                                    Foreground="{DynamicResource PrimaryBrushDynamic}"
                                    Padding="15,8"
                                    CornerRadius="8"
                                    BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Controles de Sistema -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                            Background="{DynamicResource SurfaceBrush2Dynamic}"
                            BorderBrush="{DynamicResource DividerBrushDynamic}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="10,20,10,0">
                        <Grid ColumnDefinitions="*,*,*,*">
                            <Button Grid.Column="0"
                                    Content="🔍 Mesa"
                                    Command="{Binding TrazerMesaWindowCommand}"
                                    Classes="nav"
                                    IsEnabled="{Binding MesaWindowEstaAberta}"/>
                            <Button Grid.Column="1"
                                    Content="🔍 Dashboard"
                                    Command="{Binding TrazerDashboardWindowCommand}"
                                    Classes="nav"
                                    IsEnabled="{Binding DashboardWindowEstaAberta}"/>
                            <Button Grid.Column="2"
                                    Content="🔍 Urna"
                                    Command="{Binding TrazerVotacaoWindowCommand}"
                                    Classes="nav"
                                    IsEnabled="{Binding VotacaoWindowEstaAberta}"/>
                            <Button Grid.Column="3"
                                    Content="❌ Fechar Todas"
                                    Command="{Binding FecharTodasJanelasCommand}"
                                    Classes="nav"
                                    Background="{DynamicResource ErrorBrushDynamic}"
                                    Foreground="White"/>
                        </Grid>
                    </Border>
                    
                    <!-- Status das Janelas -->
                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                            Background="{DynamicResource SurfaceBrush2Dynamic}"
                            BorderBrush="{DynamicResource DividerBrushDynamic}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="10,10,10,0">
                        <Grid ColumnDefinitions="*,*,*">
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="Dashboard" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Border Width="12" Height="12" CornerRadius="6" 
                                        Background="{DynamicResource TextHintBrushDynamic}"
                                        Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="Mesa" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Border Width="12" Height="12" CornerRadius="6" 
                                        Background="{DynamicResource TextHintBrushDynamic}"
                                        Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="Urna" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Border Width="12" Height="12" CornerRadius="6" 
                                        Background="{DynamicResource TextHintBrushDynamic}"
                                        Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
            
        <!-- Loading Overlay -->
        <Border Grid.Row="0"
                Background="#80000000" 
                IsVisible="{Binding IsLoading}">
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Spacing="10">
                <ProgressBar IsIndeterminate="True" Width="200" Height="8" Foreground="{DynamicResource PrimaryBrushDynamic}"/>
                <TextBlock Text="Carregando..." 
                           Foreground="White" 
                           FontSize="16"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
