<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:UrnaEletronicaFake.Views"
        xmlns:vm="using:UrnaEletronicaFake.ViewModels"
        mc:Ignorable="d"
        x:Class="UrnaEletronicaFake.Views.DashboardWindow"
        Width="1200" Height="800"
        Title="Dashboard de Monitoramento - Urna Eletrônica"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="/Assets/avalonia-logo.ico">
    
    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrushDynamic}"/>
        </Style>
        
        <Style Selector="Button.control-button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrushDynamic}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrushDynamic}"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrushDynamic}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
        
        <Style Selector="Button.control-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush2Dynamic}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrushDynamic}"/>
        </Style>
        
        <Style Selector="Button.control-button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrushDynamic}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrushDynamic}"/>
        </Style>
        
        <Style Selector="Button.control-button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrush2Dynamic}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush2Dynamic}"/>
        </Style>
    </Window.Styles>
    
    <Grid RowDefinitions="Auto,*">
        <!-- Header com controles da janela -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SurfaceBrushDynamic}" 
                Padding="20,10"
                BorderBrush="{DynamicResource DividerBrushDynamic}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="/Assets/avalonia-logo.ico" Width="24" Height="24"/>
                    <TextBlock Text="📊 Dashboard de Monitoramento" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrushDynamic}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            Spacing="10">
                    <Button Content="🔄 Atualizar"
                            Classes="control-button secondary"
                            Command="{Binding AtualizarDadosCommand}"
                            x:DataType="vm:DashboardViewModel"/>
                    <Button Content="❌ Fechar"
                            Classes="control-button"
                            Click="FecharJanela_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Conteúdo do Dashboard -->
        <views:DashboardView Grid.Row="1"/>
    </Grid>
</Window>
