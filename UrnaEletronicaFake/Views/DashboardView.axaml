<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UrnaEletronicaFake.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="UrnaEletronicaFake.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <UserControl.Styles>
        <Style Selector="Border.metric-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrushDynamic}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrushDynamic}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
        
        <Style Selector="TextBlock.metric-title">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrushDynamic}"/>
        </Style>
        
        <Style Selector="TextBlock.metric-value">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrushDynamic}"/>
        </Style>
        
        <Style Selector="TextBlock.metric-subtitle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrushDynamic}"/>
        </Style>
        
        <Style Selector="Border.status-indicator">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        
        <Style Selector="Border.status-indicator.ativo">
            <Setter Property="Background" Value="{DynamicResource SuccessBrushDynamic}"/>
        </Style>
        
        <Style Selector="Border.status-indicator.inativo">
            <Setter Property="Background" Value="{DynamicResource ErrorBrushDynamic}"/>
        </Style>
        
        <Style Selector="Border.status-indicator.liberada">
            <Setter Property="Background" Value="{DynamicResource SuccessBrushDynamic}"/>
        </Style>
        
        <Style Selector="Border.status-indicator.bloqueada">
            <Setter Property="Background" Value="{DynamicResource WarningBrushDynamic}"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header com Selector de Eleição -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SurfaceBrushDynamic}" 
                Padding="20,15"
                BorderBrush="{DynamicResource DividerBrushDynamic}"
                BorderThickness="0,0,0,1"
                CornerRadius="12"
                Margin="0,0,0,20">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📊 Dashboard de Monitoramento" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrushDynamic}"/>
                    
                    <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Processo Eleitoral:"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrushDynamic}"/>
                            
                            <ComboBox SelectedItem="{Binding EleicaoSelecionada}"
                                      ItemsSource="{Binding Eleicoes}"
                                      Width="400"
                                      Margin="10,0,0,0"
                                      Background="{DynamicResource SurfaceBrush2Dynamic}"
                                      Foreground="{DynamicResource TextPrimaryBrushDynamic}"
                                      BorderBrush="{DynamicResource DividerBrushDynamic}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Classes="status-indicator" 
                                                    Classes.ativo="{Binding Ativa}"
                                                    Classes.inativo="{Binding !Ativa}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Titulo}" 
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Descricao}" 
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrushDynamic}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        
                        <Button Content="🔄 Atualizar"
                                Command="{Binding AtualizarDadosCommand}"
                                Background="{DynamicResource AccentBrushDynamic}"
                                Foreground="White"
                                Padding="15,8"
                                CornerRadius="8"
                                BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrushDynamic}"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding DashboardData.UltimaAtualizacaoFormatada, StringFormat='Última atualização: {0}'}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrushDynamic}"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Métricas Principais -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" Margin="0,0,0,20">
            <!-- Total de Votos -->
            <Border Classes="metric-card">
                <StackPanel>
                    <TextBlock Text="🗳️ Total de Votos" Classes="metric-title"/>
                    <TextBlock Text="{Binding DashboardData.Estatisticas.TotalVotos}" Classes="metric-value"/>
                    <TextBlock Text="votos realizados" Classes="metric-subtitle"/>
                </StackPanel>
            </Border>

            <!-- Status da Urna -->
            <Border Classes="metric-card">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🔒 Status da Urna" Classes="metric-title"/>
                        <Border Classes="status-indicator" 
                                Classes.bloqueada="True"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DashboardData.StatusUrna}" Classes="metric-value"/>
                    <TextBlock Text="{Binding DashboardData.EleitorAtual, StringFormat='Eleitor: {0}'}" Classes="metric-subtitle"/>
                </StackPanel>
            </Border>

            <!-- Votos Válidos -->
            <Border Classes="metric-card">
                <StackPanel>
                    <TextBlock Text="✅ Votos Válidos" Classes="metric-title"/>
                    <TextBlock Text="{Binding DashboardData.Estatisticas.VotosValidos}" Classes="metric-value"/>
                    <TextBlock Text="{Binding DashboardData.Estatisticas.PercentualValidosFormatado}" Classes="metric-subtitle"/>
                </StackPanel>
            </Border>

            <!-- Votos Nulos -->
            <Border Classes="metric-card">
                <StackPanel>
                    <TextBlock Text="❌ Votos Nulos" Classes="metric-title"/>
                    <TextBlock Text="{Binding DashboardData.Estatisticas.VotosNulos}" Classes="metric-value"/>
                    <TextBlock Text="{Binding DashboardData.Estatisticas.PercentualNulosFormatado}" Classes="metric-subtitle"/>
                </StackPanel>
            </Border>

            <!-- Votos Brancos -->
            <Border Classes="metric-card">
                <StackPanel>
                    <TextBlock Text="⚪ Votos Brancos" Classes="metric-title"/>
                    <TextBlock Text="{Binding DashboardData.Estatisticas.VotosBrancos}" Classes="metric-value"/>
                    <TextBlock Text="{Binding DashboardData.Estatisticas.PercentualBrancosFormatado}" Classes="metric-subtitle"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Resultados dos Candidatos -->
        <Grid Grid.Row="2" ColumnDefinitions="*">
            <Border Background="{DynamicResource SurfaceBrushDynamic}"
                    BorderBrush="{DynamicResource DividerBrushDynamic}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="📈 Resultados por Candidato" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrushDynamic}"
                               Margin="0,0,0,20"/>
                    
                    <ItemsControl ItemsSource="{Binding DashboardData.Candidatos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush2Dynamic}"
                                        BorderBrush="{DynamicResource DividerBrushDynamic}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="15"
                                        Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <!-- Número do Candidato -->
                                        <Border Grid.Column="0"
                                                Background="{DynamicResource AccentBrushDynamic}"
                                                CornerRadius="6"
                                                Padding="12,8"
                                                Margin="0,0,15,0">
                                            <TextBlock Text="{Binding Numero}" 
                                                       FontSize="16" 
                                                       FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                        
                                        <!-- Informações do Candidato -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Nome}" 
                                                       FontSize="16" 
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrushDynamic}"/>
                                            <TextBlock Text="{Binding Partido}" 
                                                       FontSize="14"
                                                       Foreground="{DynamicResource TextSecondaryBrushDynamic}"/>
                                        </StackPanel>
                                        
                                        <!-- Votos -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Votos}" 
                                                       FontSize="20" 
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrushDynamic}"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="votos" 
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrushDynamic}"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                        
                                        <!-- Percentual -->
                                        <StackPanel Grid.Column="3" HorizontalAlignment="Right" Margin="15,0,0,0">
                                            <TextBlock Text="{Binding PercentualFormatado}" 
                                                       FontSize="18" 
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrushDynamic}"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Mensagem quando não há candidatos -->
                    <TextBlock Text="Nenhum candidato encontrado para esta eleição."
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrushDynamic}"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding !DashboardData.Candidatos.Count}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
