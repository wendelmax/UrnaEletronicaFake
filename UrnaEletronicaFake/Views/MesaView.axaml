<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UrnaEletronicaFake.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UrnaEletronicaFake.Views.MesaView"
             x:DataType="vm:MesaViewModel">

    <Grid RowDefinitions="Auto,*" Margin="20">
        <!-- Status Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SurfaceBrushDynamic}" 
                Padding="15,10"
                BorderBrush="{DynamicResource DividerBrushDynamic}"
                BorderThickness="0,0,0,1"
                CornerRadius="8"
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="🧑‍⚖️ Mesa Receptora de Votos" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryBrushDynamic}"
                           HorizontalAlignment="Center"/>
                
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="16"
                           Foreground="{DynamicResource TextSecondaryBrushDynamic}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Conteúdo Principal -->
        <StackPanel Grid.Row="1" 
                    Spacing="25" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    MaxWidth="500">
            
            <StackPanel Spacing="10">
                <TextBlock Text="Identificação do Eleitor:"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrushDynamic}"/>
                
                <TextBox Text="{Binding IdentificacaoEleitor}"
                         FontSize="18"
                         Padding="20,15"
                         Watermark="Digite o CPF ou Título de Eleitor"
                         HorizontalAlignment="Stretch"
                         Background="{DynamicResource SurfaceBrushDynamic}"
                         Foreground="{DynamicResource TextPrimaryBrushDynamic}"
                         BorderBrush="{DynamicResource DividerBrushDynamic}"
                         BorderThickness="2"
                         CornerRadius="10">
                    <TextBox.Styles>
                        <Style Selector="TextBox:focus">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrushDynamic}"/>
                        </Style>
                    </TextBox.Styles>
                </TextBox>
            </StackPanel>

            <Button Content="✅ Liberar Urna para Votação"
                    Command="{Binding LiberarUrnaCommand}"
                    HorizontalAlignment="Stretch"
                    Padding="40,20"
                    FontSize="20"
                    FontWeight="Bold"
                    Background="{DynamicResource SuccessBrushDynamic}"
                    Foreground="White"
                    CornerRadius="12"
                    BorderThickness="0">
                <Button.Styles>
                    <Style Selector="Button:disabled">
                        <Setter Property="Background" Value="{DynamicResource TextHintBrushDynamic}"/>
                        <Setter Property="Opacity" Value="0.6"/>
                    </Style>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="{DynamicResource SuccessBrush2Dynamic}"/>
                    </Style>
                </Button.Styles>
            </Button>
            
            <!-- Informações Adicionais -->
            <Border Background="{DynamicResource SurfaceBrushDynamic}" 
                    Padding="15" 
                    CornerRadius="8"
                    BorderBrush="{DynamicResource DividerBrushDynamic}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="💡 Informações:"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrushDynamic}"/>
                    
                    <TextBlock Text="• Digite o CPF ou Título do eleitor"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrushDynamic}"/>
                    
                    <TextBlock Text="• A urna será liberada para votação"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrushDynamic}"/>
                    
                    <TextBlock Text="• Após o voto, a urna será bloqueada automaticamente"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrushDynamic}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl> 