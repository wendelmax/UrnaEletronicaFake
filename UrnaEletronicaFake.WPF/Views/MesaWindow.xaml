<Window x:Class="UrnaEletronicaFake.WPF.Views.MesaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mesa Receptora" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="LightGray">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="Black" BorderThickness="2" CornerRadius="5" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="👥 Mesa Receptora" 
                           FontSize="28" FontWeight="Bold" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Interface do Mesário" 
                           FontSize="16" 
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Border Grid.Row="1" Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="20">
            <StackPanel>
                <TextBlock Text="Controle da Mesa" 
                           FontSize="20" FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Identificação do Eleitor -->
                    <Border Grid.Column="0" Background="LightBlue" BorderBrush="Blue" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Identificação do Eleitor" 
                                       FontSize="16" FontWeight="Bold" 
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,15"/>
                            
                            <TextBlock Text="CPF:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="CpfTextBox" Padding="10" Margin="0,0,0,15"/>
                            
                            <TextBlock Text="Nome:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="NomeTextBox" Padding="10" Margin="0,0,0,15"/>
                            
                            <Button Content="Verificar Eleitor" 
                                    Background="Blue" Foreground="White" 
                                    Padding="15,8" FontSize="14" Margin="0,0,0,10"/>
                            <Button Content="Liberar Votação" 
                                    Background="Green" Foreground="White" 
                                    Padding="15,8" FontSize="14" Margin="0,0,0,5" Command="{Binding LiberarVotacaoCommand}"/>
                            <Button Content="Bloquear Votação" 
                                    Background="Red" Foreground="White" 
                                    Padding="15,8" FontSize="14" Command="{Binding BloquearVotacaoCommand}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Status da Mesa -->
                    <Border Grid.Column="1" Background="LightGreen" BorderBrush="Green" BorderThickness="1" CornerRadius="5" Padding="15" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Status da Mesa" 
                                       FontSize="16" FontWeight="Bold" 
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,15"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Ellipse Fill="Green" Width="10" Height="10" Margin="0,0,8,0"/>
                                <TextBlock Text="Mesa Ativa" FontSize="14"/>
                            </StackPanel>
                            
                            <TextBlock Text="Eleitores Atendidos:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="47" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                            
                            <TextBlock Text="Última Atualização:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="14:35:23" FontSize="14" Margin="0,0,0,15"/>
                            
                            <Button Content="Iniciar Mesa" 
                                    Background="Green" Foreground="White" 
                                    Padding="15,8" FontSize="14" Margin="0,0,0,5"/>
                            <Button Content="Finalizar Mesa" 
                                    Background="Red" Foreground="White" 
                                    Padding="15,8" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>