<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores Primárias -->
    <Color x:Key="Primary50">#f0f9ff</Color>
    <Color x:Key="Primary100">#e0f2fe</Color>
    <Color x:Key="Primary200">#bae6fd</Color>
    <Color x:Key="Primary300">#7dd3fc</Color>
    <Color x:Key="Primary400">#38bdf8</Color>
    <Color x:Key="Primary500">#0ea5e9</Color>
    <Color x:Key="Primary600">#0284c7</Color>
    <Color x:Key="Primary700">#0369a1</Color>
    <Color x:Key="Primary800">#075985</Color>
    <Color x:Key="Primary900">#0c4a6e</Color>

    <!-- Cores Secundárias -->
    <Color x:Key="Secondary50">#f8fafc</Color>
    <Color x:Key="Secondary100">#f1f5f9</Color>
    <Color x:Key="Secondary200">#e2e8f0</Color>
    <Color x:Key="Secondary300">#cbd5e1</Color>
    <Color x:Key="Secondary400">#94a3b8</Color>
    <Color x:Key="Secondary500">#64748b</Color>
    <Color x:Key="Secondary600">#475569</Color>
    <Color x:Key="Secondary700">#334155</Color>
    <Color x:Key="Secondary800">#1e293b</Color>
    <Color x:Key="Secondary900">#0f172a</Color>

    <!-- Cores de Status -->
    <Color x:Key="Success50">#f0fdf4</Color>
    <Color x:Key="Success100">#dcfce7</Color>
    <Color x:Key="Success200">#bbf7d0</Color>
    <Color x:Key="Success300">#86efac</Color>
    <Color x:Key="Success400">#4ade80</Color>
    <Color x:Key="Success500">#22c55e</Color>
    <Color x:Key="Success600">#16a34a</Color>
    <Color x:Key="Success700">#15803d</Color>
    <Color x:Key="Success800">#166534</Color>
    <Color x:Key="Success900">#14532d</Color>

    <Color x:Key="Warning50">#fffbeb</Color>
    <Color x:Key="Warning100">#fef3c7</Color>
    <Color x:Key="Warning200">#fde68a</Color>
    <Color x:Key="Warning300">#fcd34d</Color>
    <Color x:Key="Warning400">#fbbf24</Color>
    <Color x:Key="Warning500">#f59e0b</Color>
    <Color x:Key="Warning600">#d97706</Color>
    <Color x:Key="Warning700">#b45309</Color>
    <Color x:Key="Warning800">#92400e</Color>
    <Color x:Key="Warning900">#78350f</Color>

    <Color x:Key="Error50">#fef2f2</Color>
    <Color x:Key="Error100">#fee2e2</Color>
    <Color x:Key="Error200">#fecaca</Color>
    <Color x:Key="Error300">#fca5a5</Color>
    <Color x:Key="Error400">#f87171</Color>
    <Color x:Key="Error500">#ef4444</Color>
    <Color x:Key="Error600">#dc2626</Color>
    <Color x:Key="Error700">#b91c1c</Color>
    <Color x:Key="Error800">#991b1b</Color>
    <Color x:Key="Error900">#7f1d1d</Color>

    <Color x:Key="Info50">#eff6ff</Color>
    <Color x:Key="Info100">#dbeafe</Color>
    <Color x:Key="Info200">#bfdbfe</Color>
    <Color x:Key="Info300">#93c5fd</Color>
    <Color x:Key="Info400">#60a5fa</Color>
    <Color x:Key="Info500">#3b82f6</Color>
    <Color x:Key="Info600">#2563eb</Color>
    <Color x:Key="Info700">#1d4ed8</Color>
    <Color x:Key="Info800">#1e40af</Color>
    <Color x:Key="Info900">#1e3a8a</Color>

    <!-- Cores Neutras -->
    <Color x:Key="Gray50">#f9fafb</Color>
    <Color x:Key="Gray100">#f3f4f6</Color>
    <Color x:Key="Gray200">#e5e7eb</Color>
    <Color x:Key="Gray300">#d1d5db</Color>
    <Color x:Key="Gray400">#9ca3af</Color>
    <Color x:Key="Gray500">#6b7280</Color>
    <Color x:Key="Gray600">#4b5563</Color>
    <Color x:Key="Gray700">#374151</Color>
    <Color x:Key="Gray800">#1f2937</Color>
    <Color x:Key="Gray900">#111827</Color>

    <!-- Cores de Fundo -->
    <Color x:Key="BackgroundPrimary">#ffffff</Color>
    <Color x:Key="BackgroundSecondary">#f8fafc</Color>
    <Color x:Key="BackgroundTertiary">#f1f5f9</Color>
    <Color x:Key="BackgroundElevated">#ffffff</Color>

    <!-- Cores de Texto -->
    <Color x:Key="TextPrimary">#0f172a</Color>
    <Color x:Key="TextSecondary">#475569</Color>
    <Color x:Key="TextTertiary">#64748b</Color>
    <Color x:Key="TextDisabled">#94a3b8</Color>
    <Color x:Key="TextOnPrimary">#ffffff</Color>
    <Color x:Key="TextOnSecondary">#ffffff</Color>
    <Color x:Key="TextOnSuccess">#ffffff</Color>
    <Color x:Key="TextOnWarning">#000000</Color>
    <Color x:Key="TextOnError">#ffffff</Color>
    <Color x:Key="TextOnInfo">#ffffff</Color>

    <!-- Cores de Borda -->
    <Color x:Key="BorderLight">#e2e8f0</Color>
    <Color x:Key="BorderMedium">#cbd5e1</Color>
    <Color x:Key="BorderStrong">#94a3b8</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary600}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource Primary400}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource Primary700}"/>
    
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary600}"/>
    <SolidColorBrush x:Key="SecondaryLightBrush" Color="{StaticResource Secondary400}"/>
    <SolidColorBrush x:Key="SecondaryDarkBrush" Color="{StaticResource Secondary700}"/>
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success600}"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource Success400}"/>
    <SolidColorBrush x:Key="SuccessDarkBrush" Color="{StaticResource Success700}"/>
    
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning600}"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource Warning400}"/>
    <SolidColorBrush x:Key="WarningDarkBrush" Color="{StaticResource Warning700}"/>
    
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error600}"/>
    <SolidColorBrush x:Key="ErrorLightBrush" Color="{StaticResource Error400}"/>
    <SolidColorBrush x:Key="ErrorDarkBrush" Color="{StaticResource Error700}"/>
    
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info600}"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="{StaticResource Info400}"/>
    <SolidColorBrush x:Key="InfoDarkBrush" Color="{StaticResource Info700}"/>
    
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundPrimary}"/>
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{StaticResource BackgroundPrimary}"/>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondary}"/>
    <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="{StaticResource BackgroundTertiary}"/>
    <SolidColorBrush x:Key="BackgroundElevatedBrush" Color="{StaticResource BackgroundElevated}"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabled}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimary}"/>
    <SolidColorBrush x:Key="TextOnSecondaryBrush" Color="{StaticResource TextOnSecondary}"/>
    <SolidColorBrush x:Key="TextOnSuccessBrush" Color="{StaticResource TextOnSuccess}"/>
    <SolidColorBrush x:Key="TextOnWarningBrush" Color="{StaticResource TextOnWarning}"/>
    <SolidColorBrush x:Key="TextOnErrorBrush" Color="{StaticResource TextOnError}"/>
    <SolidColorBrush x:Key="TextOnInfoBrush" Color="{StaticResource TextOnInfo}"/>
    
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}"/>
    <SolidColorBrush x:Key="BorderMediumBrush" Color="{StaticResource BorderMedium}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}"/>

    <!-- Gradientes -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Primary400}" Offset="0"/>
        <GradientStop Color="{StaticResource Primary600}" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Success400}" Offset="0"/>
        <GradientStop Color="{StaticResource Success600}" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="WarningGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Warning400}" Offset="0"/>
        <GradientStop Color="{StaticResource Warning600}" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="ErrorGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Error400}" Offset="0"/>
        <GradientStop Color="{StaticResource Error600}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Raios de Borda -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusXXLarge">24</CornerRadius>

    <!-- Espaçamentos -->
    <Thickness x:Key="SpaceXS">4</Thickness>
    <Thickness x:Key="SpaceSM">8</Thickness>
    <Thickness x:Key="SpaceMD">16</Thickness>
    <Thickness x:Key="SpaceLG">24</Thickness>
    <Thickness x:Key="SpaceXL">32</Thickness>
    <Thickness x:Key="SpaceXXL">48</Thickness>

    <!-- Tamanhos de Fonte -->
    <sys:Double x:Key="FontSizeXS" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="FontSizeSM" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="FontSizeMD" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
    <sys:Double x:Key="FontSizeLG" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="FontSizeXL" xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Double>
    <sys:Double x:Key="FontSizeXXL" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
    <sys:Double x:Key="FontSizeXXXL" xmlns:sys="clr-namespace:System;assembly=mscorlib">30</sys:Double>
    <sys:Double x:Key="FontSizeXXXXL" xmlns:sys="clr-namespace:System;assembly=mscorlib">36</sys:Double>

    <!-- Sombras -->
    <DropShadowEffect x:Key="ShadowSmall" 
                      Color="Black" 
                      Opacity="0.05" 
                      BlurRadius="2" 
                      ShadowDepth="1" 
                      Direction="270"/>
    
    <DropShadowEffect x:Key="ShadowMedium" 
                      Color="Black" 
                      Opacity="0.1" 
                      BlurRadius="6" 
                      ShadowDepth="4" 
                      Direction="270"/>
    
    <DropShadowEffect x:Key="ShadowLarge" 
                      Color="Black" 
                      Opacity="0.1" 
                      BlurRadius="15" 
                      ShadowDepth="10" 
                      Direction="270"/>
    
    <DropShadowEffect x:Key="ShadowXLarge" 
                      Color="Black" 
                      Opacity="0.1" 
                      BlurRadius="25" 
                      ShadowDepth="20" 
                      Direction="270"/>

    <!-- Fontes -->
    <FontFamily x:Key="FontFamilyPrimary">Segoe UI, Inter, -apple-system, BlinkMacSystemFont, Roboto, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Consolas, Monaco, 'Courier New', monospace</FontFamily>

</ResourceDictionary>
