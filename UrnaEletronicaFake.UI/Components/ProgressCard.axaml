<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="40"
             x:Class="UrnaEletronicaFake.UI.Components.ProgressCard"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="Border.progress-card">
            <Setter Property="Background" Value="{StaticResource BackgroundElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="{StaticResource SpacingM}"/>
            <Setter Property="Margin" Value="{StaticResource SpacingS}"/>
            <Setter Property="Effect" Value="{StaticResource ShadowSmall}"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="progress-card">
        <StackPanel>
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding Title}"
                           Classes="label"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Progress, StringFormat='{}{0}%'}"
                           Classes="caption"/>
            </Grid>
            
            <ProgressBar Value="{Binding Progress}"
                         Maximum="100"
                         Height="8"
                         Margin="0,4,0,0"/>
            
            <TextBlock Text="{Binding Subtitle}"
                       Classes="caption"
                       Margin="0,2,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
