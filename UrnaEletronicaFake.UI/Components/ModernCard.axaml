<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="200"
             x:Class="UrnaEletronicaFake.UI.Components.ModernCard"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="Border.modern-card">
            <Setter Property="Background" Value="{StaticResource BackgroundElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
            <Setter Property="Padding" Value="{StaticResource SpacingL}"/>
            <Setter Property="Margin" Value="{StaticResource SpacingS}"/>
            <Setter Property="Effect" Value="{StaticResource ShadowMedium}"/>
            <Setter Property="Transitions" Value="{StaticResource DefaultTransitions}"/>
        </Style>
        
        <Style Selector="Border.modern-card:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Effect" Value="{StaticResource ShadowLarge}"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        
        <Style Selector="Border.modern-card.elevated">
            <Setter Property="Effect" Value="{StaticResource ShadowLarge}"/>
        </Style>
        
        <Style Selector="Border.modern-card.success">
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
        </Style>
        
        <Style Selector="Border.modern-card.warning">
            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
            <Setter Property="Background" Value="{StaticResource WarningLightBrush}"/>
        </Style>
        
        <Style Selector="Border.modern-card.error">
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
            <Setter Property="Background" Value="{StaticResource ErrorLightBrush}"/>
        </Style>
        
        <Style Selector="Border.modern-card.info">
            <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
            <Setter Property="Background" Value="{StaticResource InfoLightBrush}"/>
        </Style>
        
        <Style Selector="Border.modern-card.primary">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource PrimarySurfaceBrush}"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="modern-card">
        <ContentPresenter Content="{Binding $parent[UserControl].Content}"/>
    </Border>
</UserControl>
