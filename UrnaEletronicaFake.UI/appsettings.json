{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=urna_eletronica.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AppSettings": {
    "ApplicationName": "UrnaEletronicaFake",
    "Version": "1.0.0",
    "Environment": "Development",
    "MaxRetryAttempts": 3,
    "SessionTimeoutMinutes": 30,
    "AuditRetentionDays": 2555
  },
  "Security": {
    "MaxLoginAttempts": 3,
    "LoginLockoutMinutes": 15,
    "PasswordMinLength": 8,
    "PasswordMaxLength": 50
  },
  "Voting": {
    "MinEleitorIdLength": 4,
    "MaxEleitorIdLength": 12,
    "SessionTimeoutMinutes": 30,
    "MaxVoteAttempts": 3,
    "VoteConfirmationTimeoutSeconds": 30
  }
}


