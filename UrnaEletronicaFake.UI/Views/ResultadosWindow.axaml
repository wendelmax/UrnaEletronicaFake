<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UrnaEletronicaFake.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="UrnaEletronicaFake.UI.Views.ResultadosWindow"
        x:DataType="vm:ResultadosViewModel"
        Title="Resultados da Eleição - Urna Eletrônica"
        Width="1200" Height="800"
        MinWidth="1000" MinHeight="700"
        Background="{StaticResource BackgroundPrimaryBrush}">

    <Design.DataContext>
        <vm:ResultadosViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource PrimaryBrush}" 
                Padding="24"
                Effect="{StaticResource ShadowMedium}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                <!-- Logo e Título -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Border Background="{StaticResource BackgroundElevatedBrush}" 
                            CornerRadius="{StaticResource RadiusLarge}" 
                            Padding="8"
                            Width="56" Height="56">
                        <TextBlock Text="📊" 
                                   FontSize="28" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Resultados da Eleição" 
                                   FontSize="{StaticResource FontSizeXxxl}" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextOnPrimaryBrush}"/>
                        <TextBlock Text="Estatísticas e Resultados Finais" 
                                   FontSize="{StaticResource FontSizeM}" 
                                   Foreground="{StaticResource TextOnPrimaryBrush}" 
                                   Opacity="0.9"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status e Controles -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            Spacing="8"
                            VerticalAlignment="Center">
                    
                    <!-- Status do Sistema -->
                    <Border Background="{StaticResource InfoBrush}" 
                            CornerRadius="{StaticResource RadiusLarge}" 
                            Padding="8">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Fill="{StaticResource TextOnPrimaryBrush}" 
                                     Width="8" Height="8"/>
                            <TextBlock Text="Resultados Disponíveis" 
                                       FontSize="{StaticResource FontSizeS}" 
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextOnPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Botão Fechar -->
                    <Button Content="✕" 
                            Classes="secondary small"
                            Padding="8"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo Principal -->
        <ScrollViewer Grid.Row="1" 
                      Padding="24" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Background="{StaticResource BackgroundElevatedBrush}" 
                    CornerRadius="{StaticResource RadiusMedium}" 
                    Padding="20"
                    Effect="{StaticResource ShadowSmall}">
                <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📊" 
                               FontSize="64" 
                               HorizontalAlignment="Center" 
                               Opacity="0.3"/>
                    <TextBlock Text="Resultados da Eleição" 
                               FontSize="{StaticResource FontSizeXl}" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Os resultados serão exibidos aqui quando a eleição for finalizada" 
                               FontSize="{StaticResource FontSizeM}" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               HorizontalAlignment="Center" 
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
