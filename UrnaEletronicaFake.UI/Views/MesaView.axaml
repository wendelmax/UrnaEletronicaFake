<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UrnaEletronicaFake.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UrnaEletronicaFake.UI.Views.MesaView"
             x:DataType="vm:MesaViewModel"
             Background="{StaticResource BackgroundPrimaryBrush}">

    <Grid RowDefinitions="Auto,*" Margin="24">

        <!-- Header -->
        <Border Grid.Row="0" 
                Classes="stat-card"
                Margin="0,0,0,24">
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                    <Border Classes="avatar large"
                            Background="{StaticResource SuccessBrush}">
                        <TextBlock Text="👥" 
                                   FontSize="32" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mesa Receptora de Votos" 
                                   Classes="heading"/>
                        <TextBlock Text="Controle de acesso dos eleitores"
                                   Classes="caption"/>
                    </StackPanel>
                </StackPanel>
                
                <Border Classes="chip" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               Classes="body"
                               HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Conteúdo Principal -->
        <StackPanel Grid.Row="1" 
                    Spacing="32" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    MaxWidth="600">
            
            <!-- Formulário de Identificação -->
            <Border Classes="stat-card">
                <StackPanel Spacing="24">
                    
                    <!-- Identificação do Mesário -->
                    <Border Classes="floating-input">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Identificação do Mesário"
                                       Classes="label"/>
                            <TextBox Text="{Binding MesarioId}"
                                     FontSize="{StaticResource FontSizeL}"
                                     Padding="12"
                                     Watermark="ID do Mesário (obrigatório)"
                                     HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- Identificação do Eleitor -->
                    <Border Classes="floating-input">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Identificação do Eleitor"
                                       Classes="label"/>
                            <TextBox Text="{Binding IdentificacaoEleitor}"
                                     FontSize="{StaticResource FontSizeL}"
                                     Padding="12"
                                     Watermark="Digite o CPF ou Título de Eleitor"
                                     HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- Botões de Ação -->
                    <StackPanel Spacing="12">
                        <Button Content="Liberar Urna para Votação"
                                Classes="success"
                                Command="{Binding LiberarUrnaCommand}"
                                HorizontalAlignment="Stretch"/>

                        <Button Content="Bloquear Urna (Emergência)"
                                Classes="error"
                                Command="{Binding BloquearUrnaCommand}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Informações do Terminal -->
            <Border Classes="stat-card">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Classes="avatar"
                                Background="{StaticResource InfoBrush}">
                            <TextBlock Text="💻" 
                                       FontSize="24" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Informações do Terminal" 
                                       Classes="subheading"/>
                            <TextBlock Text="Dados do equipamento de votação"
                                       Classes="caption"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <Grid ColumnDefinitions="Auto,*" 
                          RowDefinitions="Auto,Auto,Auto">
                        
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Terminal:"
                                   Classes="label"/>
                        <Border Grid.Row="0" Grid.Column="1" Classes="chip">
                            <TextBlock Text="{Binding TerminalId}"
                                       Classes="body"/>
                        </Border>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Última Liberação:"
                                   Classes="label"/>
                        <Border Grid.Row="1" Grid.Column="1" Classes="chip success"
                                IsVisible="{Binding UltimaLiberacao, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding UltimaLiberacao, StringFormat='{}{0:HH:mm:ss dd/MM/yyyy}'}"
                                       Classes="body"/>
                        </Border>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Último Bloqueio:"
                                   Classes="label"/>
                        <Border Grid.Row="2" Grid.Column="1" Classes="chip error"
                                IsVisible="{Binding UltimoBloqueio, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding UltimoBloqueio, StringFormat='{}{0:HH:mm:ss dd/MM/yyyy}'}"
                                       Classes="body"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Informações Adicionais -->
            <Border Classes="stat-card info">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Classes="avatar"
                                Background="{StaticResource InfoBrush}">
                            <TextBlock Text="ℹ️" 
                                       FontSize="24" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Informações Importantes"
                                       Classes="subheading"/>
                            <TextBlock Text="Orientações para o mesário"
                                       Classes="caption"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel Spacing="8">
                        <Border Classes="chip">
                            <TextBlock Text="• Digite o CPF ou Título do eleitor"
                                       Classes="body"/>
                        </Border>
                        <Border Classes="chip">
                            <TextBlock Text="• A urna será liberada para votação"
                                       Classes="body"/>
                        </Border>
                        <Border Classes="chip">
                            <TextBlock Text="• Após o voto, a urna será bloqueada automaticamente"
                                       Classes="body"/>
                        </Border>
                        <Border Classes="chip error">
                            <TextBlock Text="• Em caso de emergência, use o botão de bloqueio"
                                       Classes="body"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Botão de Limpeza -->
            <Button Content="Limpar Log"
                    Classes="secondary small"
                    Command="{Binding LimparLogCommand}"
                    HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl> 