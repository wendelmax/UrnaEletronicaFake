<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UrnaEletronicaFake.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="UrnaEletronicaFake.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             Background="{StaticResource BackgroundPrimaryBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Classes="stat-card"
                Margin="0,0,0,24">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Classes="avatar">
                            <TextBlock Text="📊" 
                                       FontSize="24" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Dashboard de Monitoramento" 
                                       Classes="heading"/>
                            <TextBlock Text="Acompanhamento em tempo real do processo eleitoral"
                                       Classes="caption"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" 
                                Spacing="24" 
                                Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" 
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <Border Classes="chip">
                                <TextBlock Text="Eleição:"
                                           FontSize="{StaticResource FontSizeS}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            
                            <ComboBox SelectedItem="{Binding EleicaoSelecionada}"
                                      ItemsSource="{Binding Eleicoes}"
                                      Width="400"
                                      Classes="secondary">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse Classes="status-online" 
                                                     IsVisible="{Binding Ativa}"/>
                                            <Ellipse Classes="status-offline" 
                                                     IsVisible="{Binding !Ativa}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Titulo}" 
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Descricao}" 
                                                           FontSize="{StaticResource FontSizeS}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        
                        <Button Content="Atualizar"
                                Classes="gradient"
                                Command="{Binding AtualizarDadosCommand}"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" 
                            VerticalAlignment="Center"
                            Spacing="4">
                    <TextBlock Text="{Binding StatusMessage}"
                               Classes="body"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding DashboardData.UltimaAtualizacaoFormatada, StringFormat='Última atualização: {0}'}"
                               Classes="caption"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Métricas Principais -->
        <Grid Grid.Row="1" 
              ColumnDefinitions="*,*,*,*,*" 
              Margin="0,0,0,24">
            
            <!-- Total de Votos -->
            <Border Classes="stat-card">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="avatar small"
                                Background="{StaticResource PrimaryBrush}">
                            <TextBlock Text="🗳️" 
                                       FontSize="12" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Total de Votos" 
                                       Classes="label"/>
                            <TextBlock Text="votos realizados" 
                                       Classes="caption"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding DashboardData.Estatisticas.TotalVotos}" 
                               FontSize="{StaticResource FontSizeXxxl}"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Status da Urna -->
            <Border Classes="stat-card warning">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="avatar small"
                                Background="{StaticResource WarningBrush}">
                            <TextBlock Text="⚠️" 
                                       FontSize="12" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Status da Urna" 
                                       Classes="label"/>
                            <Ellipse Classes="status-warning"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding DashboardData.StatusUrna}" 
                               FontSize="{StaticResource FontSizeXxxl}"
                               FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding DashboardData.EleitorAtual, StringFormat='Eleitor: {0}'}" 
                               Classes="caption"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Votos Válidos -->
            <Border Classes="stat-card success">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="avatar small"
                                Background="{StaticResource SuccessBrush}">
                            <TextBlock Text="✅" 
                                       FontSize="12" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Votos Válidos" 
                                       Classes="label"/>
                            <TextBlock Text="{Binding DashboardData.Estatisticas.PercentualValidosFormatado}" 
                                       Classes="caption"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding DashboardData.Estatisticas.VotosValidos}" 
                               FontSize="{StaticResource FontSizeXxxl}"
                               FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Votos Nulos -->
            <Border Classes="stat-card error">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="avatar small"
                                Background="{StaticResource ErrorBrush}">
                            <TextBlock Text="❌" 
                                       FontSize="12" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Votos Nulos" 
                                       Classes="label"/>
                            <TextBlock Text="{Binding DashboardData.Estatisticas.PercentualNulosFormatado}" 
                                       Classes="caption"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding DashboardData.Estatisticas.VotosNulos}" 
                               FontSize="{StaticResource FontSizeXxxl}"
                               FontWeight="Bold"
                               Foreground="{StaticResource ErrorBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Votos Brancos -->
            <Border Classes="stat-card info">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="avatar small"
                                Background="{StaticResource InfoBrush}">
                            <TextBlock Text="⚪" 
                                       FontSize="12" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Votos Brancos" 
                                       Classes="label"/>
                            <TextBlock Text="{Binding DashboardData.Estatisticas.PercentualBrancosFormatado}" 
                                       Classes="caption"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding DashboardData.Estatisticas.VotosBrancos}" 
                               FontSize="{StaticResource FontSizeXxxl}"
                               FontWeight="Bold"
                               Foreground="{StaticResource InfoBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Resultados dos Candidatos -->
        <Border Grid.Row="2" 
                Classes="stat-card">
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Border Classes="avatar">
                        <TextBlock Text="👥" 
                                   FontSize="24" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Resultados por Candidato" 
                                   Classes="subheading"/>
                        <TextBlock Text="Acompanhamento dos votos por candidato"
                                   Classes="caption"/>
                    </StackPanel>
                </StackPanel>
                
                <ItemsControl ItemsSource="{Binding DashboardData.Candidatos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="stat-card"
                                    Margin="0,0,0,12">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    
                                    <!-- Número do Candidato -->
                                    <Border Grid.Column="0"
                                            Classes="avatar"
                                            Background="{StaticResource PrimaryBrush}"
                                            Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Numero}" 
                                                   FontSize="{StaticResource FontSizeL}" 
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextOnPrimaryBrush}"/>
                                    </Border>
                                    
                                    <!-- Informações do Candidato -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nome}" 
                                                   Classes="subheading"/>
                                        <TextBlock Text="{Binding Partido}" 
                                                   Classes="body"/>
                                    </StackPanel>
                                    
                                    <!-- Votos -->
                                    <StackPanel Grid.Column="2" 
                                                HorizontalAlignment="Right"
                                                Margin="16,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Votos}" 
                                                   FontSize="{StaticResource FontSizeXxl}" 
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="votos" 
                                                   Classes="caption"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                    
                                    <!-- Percentual -->
                                    <StackPanel Grid.Column="3" 
                                                HorizontalAlignment="Right" 
                                                Margin="16,0,0,0"
                                                VerticalAlignment="Center">
                                        <Border Classes="chip">
                                            <TextBlock Text="{Binding PercentualFormatado}" 
                                                       FontSize="{StaticResource FontSizeS}" 
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Mensagem quando não há candidatos -->
                <Border Classes="stat-card" IsVisible="{Binding !DashboardData.Candidatos.Count}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nenhum candidato encontrado para esta eleição."
                                   Classes="body"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>