<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    
    <!-- ============================================ -->
    <!-- PALETA DE CORES - MATERIAL DESIGN -->
    <!-- ============================================ -->
    
    <!-- Cores Primárias -->
    <Color x:Key="Primary50">#E3F2FD</Color>
    <Color x:Key="Primary100">#BBDEFB</Color>
    <Color x:Key="Primary200">#90CAF9</Color>
    <Color x:Key="Primary300">#64B5F6</Color>
    <Color x:Key="Primary400">#42A5F5</Color>
    <Color x:Key="Primary500">#2196F3</Color>
    <Color x:Key="Primary600">#1E88E5</Color>
    <Color x:Key="Primary700">#1976D2</Color>
    <Color x:Key="Primary800">#1565C0</Color>
    <Color x:Key="Primary900">#0D47A1</Color>
    
    <!-- Cores Secundárias -->
    <Color x:Key="Secondary50">#FFF3E0</Color>
    <Color x:Key="Secondary100">#FFE0B2</Color>
    <Color x:Key="Secondary200">#FFCC80</Color>
    <Color x:Key="Secondary300">#FFB74D</Color>
    <Color x:Key="Secondary400">#FFA726</Color>
    <Color x:Key="Secondary500">#FF9800</Color>
    <Color x:Key="Secondary600">#FB8C00</Color>
    <Color x:Key="Secondary700">#F57C00</Color>
    <Color x:Key="Secondary800">#EF6C00</Color>
    <Color x:Key="Secondary900">#E65100</Color>
    
    <!-- Cores de Estado -->
    <Color x:Key="Success50">#E8F5E8</Color>
    <Color x:Key="Success500">#4CAF50</Color>
    <Color x:Key="Success600">#43A047</Color>
    <Color x:Key="Success700">#388E3C</Color>
    
    <Color x:Key="Warning50">#FFF8E1</Color>
    <Color x:Key="Warning500">#FF9800</Color>
    <Color x:Key="Warning600">#FB8C00</Color>
    <Color x:Key="Warning700">#F57C00</Color>
    
    <Color x:Key="Error50">#FFEBEE</Color>
    <Color x:Key="Error500">#F44336</Color>
    <Color x:Key="Error600">#E53935</Color>
    <Color x:Key="Error700">#D32F2F</Color>
    
    <Color x:Key="Info50">#E3F2FD</Color>
    <Color x:Key="Info500">#2196F3</Color>
    <Color x:Key="Info600">#1E88E5</Color>
    <Color x:Key="Info700">#1976D2</Color>
    
    <!-- Cores Neutras -->
    <Color x:Key="Gray50">#FAFAFA</Color>
    <Color x:Key="Gray100">#F5F5F5</Color>
    <Color x:Key="Gray200">#EEEEEE</Color>
    <Color x:Key="Gray300">#E0E0E0</Color>
    <Color x:Key="Gray400">#BDBDBD</Color>
    <Color x:Key="Gray500">#9E9E9E</Color>
    <Color x:Key="Gray600">#757575</Color>
    <Color x:Key="Gray700">#616161</Color>
    <Color x:Key="Gray800">#424242</Color>
    <Color x:Key="Gray900">#212121</Color>
    
    <!-- Cores de Fundo -->
    <Color x:Key="BackgroundPrimary">#FFFFFF</Color>
    <Color x:Key="BackgroundSecondary">#FAFAFA</Color>
    <Color x:Key="BackgroundTertiary">#F5F5F5</Color>
    <Color x:Key="BackgroundElevated">#FFFFFF</Color>
    
    <!-- Cores de Texto -->
    <Color x:Key="TextPrimary">#212121</Color>
    <Color x:Key="TextSecondary">#757575</Color>
    <Color x:Key="TextDisabled">#BDBDBD</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>
    <Color x:Key="TextOnSecondary">#FFFFFF</Color>
    
    <!-- Cores de Borda -->
    <Color x:Key="BorderLight">#E0E0E0</Color>
    <Color x:Key="BorderMedium">#BDBDBD</Color>
    <Color x:Key="BorderDark">#757575</Color>
    
    <!-- ============================================ -->
    <!-- BRUSHES SEMÂNTICOS -->
    <!-- ============================================ -->
    
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{StaticResource BackgroundPrimary}"/>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondary}"/>
    <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="{StaticResource BackgroundTertiary}"/>
    <SolidColorBrush x:Key="BackgroundElevatedBrush" Color="{StaticResource BackgroundElevated}"/>
    
    <!-- Texto -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabled}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimary}"/>
    <SolidColorBrush x:Key="TextOnSecondaryBrush" Color="{StaticResource TextOnSecondary}"/>
    
    <!-- Bordas -->
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}"/>
    <SolidColorBrush x:Key="BorderMediumBrush" Color="{StaticResource BorderMedium}"/>
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDark}"/>
    
    <!-- Estados -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary500}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource Primary700}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource Primary300}"/>
    <SolidColorBrush x:Key="PrimarySurfaceBrush" Color="{StaticResource Primary50}"/>
    
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary500}"/>
    <SolidColorBrush x:Key="SecondaryDarkBrush" Color="{StaticResource Secondary700}"/>
    <SolidColorBrush x:Key="SecondaryLightBrush" Color="{StaticResource Secondary300}"/>
    <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="{StaticResource Secondary50}"/>
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success500}"/>
    <SolidColorBrush x:Key="SuccessDarkBrush" Color="{StaticResource Success700}"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource Success50}"/>
    
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning500}"/>
    <SolidColorBrush x:Key="WarningDarkBrush" Color="{StaticResource Warning700}"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource Warning50}"/>
    
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error500}"/>
    <SolidColorBrush x:Key="ErrorDarkBrush" Color="{StaticResource Error700}"/>
    <SolidColorBrush x:Key="ErrorLightBrush" Color="{StaticResource Error50}"/>
    
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info500}"/>
    <SolidColorBrush x:Key="InfoDarkBrush" Color="{StaticResource Info700}"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="{StaticResource Info50}"/>
    
    <!-- Neutros -->
    <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="NeutralLightBrush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="NeutralDarkBrush" Color="{StaticResource Gray800}"/>
    
    <!-- ============================================ -->
    <!-- TIPOGRAFIA -->
    <!-- ============================================ -->
    
    <x:Double x:Key="FontSizeXs">10</x:Double>
    <x:Double x:Key="FontSizeS">12</x:Double>
    <x:Double x:Key="FontSizeM">14</x:Double>
    <x:Double x:Key="FontSizeL">16</x:Double>
    <x:Double x:Key="FontSizeXl">20</x:Double>
    <x:Double x:Key="FontSizeXxl">24</x:Double>
    <x:Double x:Key="FontSizeXxxl">32</x:Double>
    <x:Double x:Key="FontSizeDisplay">48</x:Double>
    
    <!-- ============================================ -->
    <!-- ESPAÇAMENTOS -->
    <!-- ============================================ -->
    
    <Thickness x:Key="SpacingXs">4</Thickness>
    <Thickness x:Key="SpacingS">8</Thickness>
    <Thickness x:Key="SpacingM">16</Thickness>
    <Thickness x:Key="SpacingL">24</Thickness>
    <Thickness x:Key="SpacingXl">32</Thickness>
    <Thickness x:Key="SpacingXxl">48</Thickness>
    
    <!-- ============================================ -->
    <!-- BORDAS ARREDONDADAS -->
    <!-- ============================================ -->
    
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusFull">9999</CornerRadius>
    
    <!-- ============================================ -->
    <!-- SOMBRAS -->
    <!-- ============================================ -->
    
    <DropShadowEffect x:Key="ShadowSmall" 
                      BlurRadius="4" 
                      OffsetX="0" 
                      OffsetY="2" 
                      Color="#10000000"/>
    
    <DropShadowEffect x:Key="ShadowMedium" 
                      BlurRadius="8" 
                      OffsetX="0" 
                      OffsetY="4" 
                      Color="#20000000"/>
    
    <DropShadowEffect x:Key="ShadowLarge" 
                      BlurRadius="16" 
                      OffsetX="0" 
                      OffsetY="8" 
                      Color="#30000000"/>
    
    <!-- ============================================ -->
    <!-- ALTURAS DE COMPONENTES -->
    <!-- ============================================ -->
    
    <x:Double x:Key="ComponentHeightXS">24</x:Double>
    <x:Double x:Key="ComponentHeightS">32</x:Double>
    <x:Double x:Key="ComponentHeightM">40</x:Double>
    <x:Double x:Key="ComponentHeightL">48</x:Double>
    <x:Double x:Key="ComponentHeightXL">56</x:Double>
    <x:Double x:Key="ComponentHeightXXL">64</x:Double>
    
    <!-- ============================================ -->
    <!-- TRANSIÇÕES -->
    <!-- ============================================ -->
    
    <Transitions x:Key="DefaultTransitions"/>
    
    <!-- ============================================ -->
    <!-- LARGURAS DE COMPONENTES -->
    <!-- ============================================ -->
    
    <x:Double x:Key="ComponentWidthXS">80</x:Double>
    <x:Double x:Key="ComponentWidthS">120</x:Double>
    <x:Double x:Key="ComponentWidthM">160</x:Double>
    <x:Double x:Key="ComponentWidthL">200</x:Double>
    <x:Double x:Key="ComponentWidthXL">240</x:Double>
    <x:Double x:Key="ComponentWidthXXL">320</x:Double>
    
</ResourceDictionary>

