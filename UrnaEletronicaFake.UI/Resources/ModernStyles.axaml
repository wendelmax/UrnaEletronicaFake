<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Estilos Modernos para Urna Eletrônica -->

    <!-- Botões com Gradiente -->
    <Style Selector="Button.gradient">
        <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
        <Setter Property="Padding" Value="{StaticResource SpacingL}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeM}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="{StaticResource ComponentHeightL}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect" Value="{StaticResource ShadowMedium}"/>
    </Style>

    <Style Selector="Button.gradient:pointerover">
        <Setter Property="Effect" Value="{StaticResource ShadowLarge}"/>
        <Setter Property="RenderTransform" Value="scale(1.05)"/>
    </Style>

    <Style Selector="Button.gradient:pressed">
        <Setter Property="RenderTransform" Value="scale(0.95)"/>
        <Setter Property="Effect" Value="{StaticResource ShadowSmall}"/>
    </Style>

    <!-- Cards com Efeito Glass -->
    <Style Selector="Border.glass-card">
        <Setter Property="Background" Value="rgba(255, 255, 255, 0.1)"/>
        <Setter Property="BorderBrush" Value="rgba(255, 255, 255, 0.2)"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="{StaticResource SpacingL}"/>
        <Setter Property="Margin" Value="{StaticResource SpacingS}"/>
        <Setter Property="Effect" Value="{StaticResource ShadowLarge}"/>
    </Style>

    <Style Selector="Border.glass-card:pointerover">
        <Setter Property="Background" Value="rgba(255, 255, 255, 0.15)"/>
        <Setter Property="BorderBrush" Value="rgba(255, 255, 255, 0.3)"/>
        <Setter Property="Effect" Value="{StaticResource ShadowLarge}"/>
        <Setter Property="RenderTransform" Value="scale(1.02)"/>
    </Style>

    <!-- Inputs Modernos com Floating Label -->
    <Style Selector="Border.floating-input">
        <Setter Property="Background" Value="{StaticResource BackgroundElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
        <Setter Property="Padding" Value="{StaticResource SpacingM}"/>
    </Style>

    <Style Selector="Border.floating-input:focus-within">
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Effect" Value="{StaticResource ShadowMedium}"/>
    </Style>

    <!-- Chips/Tags -->
    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{StaticResource PrimarySurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="{StaticResource SpacingM}"/>
        <Setter Property="Margin" Value="{StaticResource SpacingXs}"/>
    </Style>

    <Style Selector="Border.chip:pointerover">
        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
        <Setter Property="Effect" Value="{StaticResource ShadowSmall}"/>
    </Style>

    <Style Selector="Border.chip.removable">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Border.chip.removable:pointerover">
        <Setter Property="Background" Value="{StaticResource ErrorLightBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
    </Style>

    <!-- Avatar -->
    <Style Selector="Border.avatar">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="50"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Effect" Value="{StaticResource ShadowSmall}"/>
    </Style>

    <Style Selector="Border.avatar.large">
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="64"/>
    </Style>

    <Style Selector="Border.avatar.small">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
    </Style>

    <!-- Timeline -->
    <Style Selector="Border.timeline-item">
        <Setter Property="Margin" Value="0,8,0,8"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="Border.timeline-dot">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style Selector="Border.timeline-line">
        <Setter Property="Background" Value="{StaticResource BorderLightBrush}"/>
        <Setter Property="Width" Value="2"/>
        <Setter Property="Height" Value="100"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
    </Style>

    <!-- Stats Cards -->
    <Style Selector="Border.stat-card">
        <Setter Property="Background" Value="{StaticResource BackgroundElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="{StaticResource SpacingL}"/>
        <Setter Property="Margin" Value="{StaticResource SpacingS}"/>
        <Setter Property="Effect" Value="{StaticResource ShadowMedium}"/>
    </Style>

    <Style Selector="Border.stat-card:pointerover">
        <Setter Property="Effect" Value="{StaticResource ShadowLarge}"/>
        <Setter Property="RenderTransform" Value="scale(1.02)"/>
    </Style>

    <Style Selector="Border.stat-card.success">
        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
        <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
    </Style>

    <Style Selector="Border.stat-card.warning">
        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
        <Setter Property="Background" Value="{StaticResource WarningLightBrush}"/>
    </Style>

    <Style Selector="Border.stat-card.error">
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="Background" Value="{StaticResource ErrorLightBrush}"/>
    </Style>

    <!-- Floating Action Button -->
    <Style Selector="Button.fab">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="50"/>
        <Setter Property="Width" Value="56"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Effect" Value="{StaticResource ShadowLarge}"/>
    </Style>

    <Style Selector="Button.fab:pointerover">
        <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
        <Setter Property="Effect" Value="{StaticResource ShadowLarge}"/>
        <Setter Property="RenderTransform" Value="scale(1.1)"/>
    </Style>

    <Style Selector="Button.fab:pressed">
        <Setter Property="RenderTransform" Value="scale(0.9)"/>
    </Style>

    <!-- Skeleton Loading -->
    <Style Selector="Border.skeleton">
        <Setter Property="Background" Value="{StaticResource BackgroundTertiaryBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Effect" Value="{StaticResource ShadowSmall}"/>
    </Style>

    <Style Selector="Border.skeleton.animated">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{StaticResource BackgroundTertiary}" Offset="0"/>
                    <GradientStop Color="{StaticResource BackgroundSecondary}" Offset="0.5"/>
                    <GradientStop Color="{StaticResource BackgroundTertiary}" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar -->
    <Style Selector="Border.toolbar">
        <Setter Property="Background" Value="{StaticResource BackgroundElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="{StaticResource SpacingM}"/>
        <Setter Property="Effect" Value="{StaticResource ShadowSmall}"/>
    </Style>

    <!-- Sidebar -->
    <Style Selector="Border.sidebar">
        <Setter Property="Background" Value="{StaticResource BackgroundSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Padding" Value="{StaticResource SpacingM}"/>
        <Setter Property="Effect" Value="{StaticResource ShadowMedium}"/>
    </Style>

    <!-- Navigation Items -->
    <Style Selector="Button.nav-item">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
        <Setter Property="Padding" Value="{StaticResource SpacingM}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeM}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style Selector="Button.nav-item:pointerover">
        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.nav-item:selected">
        <Setter Property="Background" Value="{StaticResource PrimarySurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

</Styles>